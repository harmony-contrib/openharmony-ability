/** Shared hilog domain for all openharmony-ability modules */
export const DOMAIN: number = 0x1999;

/** AppStorage key for the native NAPI module shared across ArkUI components */
export const NATIVE_MODULE_STORAGE_KEY: string = '__native_module__';

/** Main window is always ID 0 (sub-windows are assigned id > 0 by WindowManager) */
export const MAIN_WINDOW_ID: number = 0;
