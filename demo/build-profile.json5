{
  "app": {
    "products": [
      {
        "name": "default",
        "compatibleSdkVersion": "5.0.0(12)",
        "targetSdkVersion": "5.0.0(12)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true,
          },
        },
      },
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release",
      },
    ],
    // Signing material is machine-local and must never be committed. DevEco Studio regenerates
    // this block ("File > Project Structure > Signing Configs") for local signed builds.
    "signingConfigs": [],
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": ["default"],
        },
      ],
    },
    {
      "name": "native_ability",
      "srcPath": "../native_ability",
    },
    {
      "name": "plugin_app_control",
      "srcPath": "../plugins/app-control",
    },
    {
      "name": "plugin_permission",
      "srcPath": "../plugins/permission",
    },
    {
      "name": "plugin_resource",
      "srcPath": "../plugins/resource",
    },
    {
      "name": "plugin_webview",
      "srcPath": "../plugins/webview",
    },
    {
      "name": "plugin_window",
      "srcPath": "../plugins/window",
    },
    {
      "name": "plugin_url",
      "srcPath": "../plugins/url",
    },
    {
      "name": "plugin_files",
      "srcPath": "../plugins/files",
    },
  ],
}
