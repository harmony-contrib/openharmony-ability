{
  "$schema": "./node_modules/@ohos-rs/oxk/configuration_schema.json",
  "plugins": ["unicorn", "typescript", "oxc", "arkts"],
  "rules": {
    // ArkTS compiler rejects `as const` (arkts-no-as-const); keep literal type annotations.
    "typescript/prefer-as-const": "off",
    "arkts/system-api-version": [
      "error",
      {
        "minApiVersion": 12,
        // AutostartPlugin guards this API-21 call with deviceInfo.sdkApiVersion.
        "apis": {
          "@kit.AbilityKit.autoStartupManager.getAutoStartupStatusForSelf": 12,
          // The API 24 SDK declaration retains @since 9 for this overload.
          "@ohos.pasteboard.createData": 9
        }
      }
    ]
  }
}
